+// Talent rank bonuses (wowproject): +ranks to a talent from outside the talent tree, e.g. a gear affix (mod-forge).
+// The talent tree itself never changes: the client still shows the points spent, the server makes the talent work
+// at spent + bonus ranks.
+
+#include "Player.h"
+#include "SpellAuraEffects.h"
+#include "SpellMgr.h"
+#include <cmath>
+
+namespace
+{
+    uint8 GetTalentMaxRank(TalentEntry const* talentInfo)
+    {
+        uint8 maxRank = 0;
+        for (uint8 rank = 0; rank < MAX_TALENT_RANK; ++rank)
+            if (talentInfo->RankID[rank])
+                maxRank = rank + 1;
+        return maxRank;
+    }
+
+    // value(rank) at any rank: past the last rank, each rank adds the step between the last two (the first rank's
+    // value for a one-rank talent).
+    template <typename ValueFn>
+    float TalentRankValue(TalentEntry const* talentInfo, uint32 rank, ValueFn value)
+    {
+        uint8 maxRank = GetTalentMaxRank(talentInfo);
+        if (!maxRank || !rank)
+            return 0.0f;
+        auto at = [&](uint8 r) -> float
+        {
+            SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(talentInfo->RankID[r - 1]);
+            return spellInfo ? value(spellInfo) : 0.0f;
+        };
+        if (rank <= maxRank)
+            return at(rank);
+        float top = at(maxRank);
+        float step = maxRank > 1 ? top - at(maxRank - 1) : top;
+        return top + float(rank - maxRank) * step;
+    }
+}
+
+void Player::SetTalentRankBonus(uint32 talentId, uint8 bonus)
+{
+    if (bonus)
+        m_talentRankBonus[talentId] = bonus;
+    else if (!m_talentRankBonus.erase(talentId) && !m_talentBonusGrant.count(talentId))
+        return;
+
+    if (IsInWorld())
+        UpdateTalentRankBonus(talentId);
+}
+
+uint8 Player::GetTalentRankBonus(uint32 talentId) const
+{
+    auto itr = m_talentRankBonus.find(talentId);
+    return itr != m_talentRankBonus.end() ? itr->second : 0;
+}
+
+void Player::UpdateTalentRankBonuses()
+{
+    std::vector<uint32> talents;
+    for (auto const& [talentId, bonus] : m_talentRankBonus)
+        talents.push_back(talentId);
+    for (auto const& [talentId, spellId] : m_talentBonusGrant)
+        if (!m_talentRankBonus.count(talentId))
+            talents.push_back(talentId);
+    for (uint32 talentId : talents)
+        UpdateTalentRankBonus(talentId);
+}
+
+uint8 Player::GetSpentTalentRank(TalentEntry const* talentInfo) const
+{
+    for (uint8 rank = 0; rank < MAX_TALENT_RANK; ++rank)
+        if (talentInfo->RankID[rank] && HasTalent(talentInfo->RankID[rank], GetActiveSpec()))
+            return rank + 1;
+    return 0;
+}
+
+void Player::UpdateTalentRankBonus(uint32 talentId)
+{
+    TalentEntry const* talentInfo = sTalentStore.LookupEntry(talentId);
+    if (!talentInfo)
+        return;
+
+    // Only the player's own class: another class's talent does nothing.
+    TalentTabEntry const* talentTab = sTalentTabStore.LookupEntry(talentInfo->TalentTab);
+    uint8 bonus = talentTab && (getClassMask() & talentTab->ClassMask) ? GetTalentRankBonus(talentId) : 0;
+    uint8 spent = GetSpentTalentRank(talentInfo);
+    uint8 maxRank = GetTalentMaxRank(talentInfo);
+
+    // No points spent: the bonus grants the talent at its rank (the last rank, and more past it).
+    uint32 grant = 0;
+    if (!spent && bonus && maxRank)
+        grant = talentInfo->RankID[std::min(bonus, maxRank) - 1];
+    SetTalentBonusGrant(talentId, grant);
+
+    // The talent's aura (spent or granted) recalculates its amounts with the bonus.
+    uint32 spellId = spent ? talentInfo->RankID[spent - 1] : grant;
+    if (Aura* aura = spellId ? GetOwnedAura(spellId, GetGUID()) : nullptr)
+        for (uint8 i = 0; i < MAX_SPELL_EFFECTS; ++i)
+            if (AuraEffect* aurEff = aura->GetEffect(i))
+                aurEff->RecalculateAmount(this);
+}
+
+void Player::SetTalentBonusGrant(uint32 talentId, uint32 spellId)
+{
+    auto itr = m_talentBonusGrant.find(talentId);
+    uint32 old = itr != m_talentBonusGrant.end() ? itr->second : 0;
+    if (old == spellId)
+        return;
+
+    TalentEntry const* talentInfo = sTalentStore.LookupEntry(talentId);
+    // Like LearnTalent and resetTalents: an active talent spell (Pyroblast) goes into the spell book, a passive one
+    // or one with learn effects applies its auras and spells. Spells from a grant are temporary, never saved.
+    auto inSpellBook = [talentInfo](SpellInfo const* spellInfo)
+    {
+        return talentInfo->addToSpellBook && !spellInfo->HasAttribute(SPELL_ATTR0_PASSIVE) &&
+            !spellInfo->HasEffect(SPELL_EFFECT_LEARN_SPELL);
+    };
+
+    if (SpellInfo const* spellInfo = old ? sSpellMgr->GetSpellInfo(old) : nullptr)
+    {
+        _removeTalentAurasAndSpells(old);
+        if (inSpellBook(spellInfo))
+        {
+            // Also the higher ranks learned on top of it: they stay known for no spec, like after a talent reset,
+            // and come back with the next grant or the talent.
+            removeSpell(old, GetActiveSpecMask(), false);
+            // A talent spell is kept in m_spells for no spec; a temporary one would block learning it again.
+            auto spell = m_spells.find(old);
+            if (spell != m_spells.end() && spell->second->State == PLAYERSPELL_TEMPORARY && !spell->second->specMask)
+            {
+                delete spell->second;
+                m_spells.erase(spell);
+            }
+        }
+        else
+            SendLearnPacket(old, false);
+    }
+    if (old)
+        m_talentBonusGrant.erase(talentId);
+
+    if (SpellInfo const* spellInfo = spellId ? sSpellMgr->GetSpellInfo(spellId) : nullptr)
+    {
+        m_talentBonusGrant[talentId] = spellId;
+        if (inSpellBook(spellInfo))
+            learnSpell(spellId, true); // restores the higher ranks known for no spec
+        else
+        {
+            SendLearnPacket(spellId, true);
+            _addTalentAurasAndSpells(spellId);
+        }
+    }
+}
+
+int32 Player::GetTalentBonusAmount(SpellInfo const* spellInfo, uint8 effIndex, int32 amount) const
+{
+    if (m_talentRankBonus.empty() || !spellInfo->IsPassive())
+        return amount;
+    TalentSpellPos const* talentPos = GetTalentSpellPos(spellInfo->Id);
+    uint8 bonus = talentPos ? GetTalentRankBonus(talentPos->talent_id) : 0;
+    TalentEntry const* talentInfo = bonus ? sTalentStore.LookupEntry(talentPos->talent_id) : nullptr;
+    if (!talentInfo)
+        return amount;
+
+    uint32 rank = talentPos->rank + 1;
+    uint8 spent = GetSpentTalentRank(talentInfo);
+    uint32 effective = spent ? spent + bonus : bonus;
+    if (effective <= rank)
+        return amount;
+
+    auto value = [this, effIndex](SpellInfo const* rankInfo) { return float(rankInfo->Effects[effIndex].CalcValue(this)); };
+    float delta = TalentRankValue(talentInfo, effective, value) - TalentRankValue(talentInfo, rank, value);
+    return amount + int32(std::lround(delta));
+}
+
+float Player::GetTalentBonusProcChance(SpellInfo const* spellInfo, float chance) const
+{
+    if (m_talentRankBonus.empty() || !spellInfo->IsPassive())
+        return chance;
+    TalentSpellPos const* talentPos = GetTalentSpellPos(spellInfo->Id);
+    uint8 bonus = talentPos ? GetTalentRankBonus(talentPos->talent_id) : 0;
+    TalentEntry const* talentInfo = bonus ? sTalentStore.LookupEntry(talentPos->talent_id) : nullptr;
+    if (!talentInfo)
+        return chance;
+
+    uint32 rank = talentPos->rank + 1;
+    uint8 spent = GetSpentTalentRank(talentInfo);
+    uint32 effective = spent ? spent + bonus : bonus;
+    if (effective <= rank)
+        return chance;
+
+    // Each rank's own proc chance (spell_proc, else Spell.dbc). Over 100% simply always procs.
+    auto value = [](SpellInfo const* rankInfo)
+    {
+        SpellProcEntry const* procEntry = sSpellMgr->GetSpellProcEntry(rankInfo->Id);
+        return procEntry && procEntry->Chance ? procEntry->Chance : float(rankInfo->ProcChance);
+    };
+    return chance + TalentRankValue(talentInfo, effective, value) - TalentRankValue(talentInfo, rank, value);
+}
